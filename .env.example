# ===== 签到雷达 · 本地账号配置示例 =====
# 推荐直接在程序内「账号 → 添加账号」录入，程序会自动保存到本地 accounts.env。
# 如需手动配置，可复制本文件为 data/accounts.env（开发模式）或 .env 并填入自己的账号。
# 注意：不要将包含真实学号和密码的 .env 文件上传到公开仓库！

# 主账号
ZJU_USER=202600000001
ZJU_PASSWORD=your_password_here
ZJU_LABEL=主账号
# 预设点位 ID/名称（如 东一教学楼 / zjg-dong1）或 经度,纬度；留空则使用全局默认点位
ZJU_LOCATION=
ZJU_ENABLED=true
ZJU_AUTO_ANSWER=true

# 附加账号（可选，支持 _2 / _3 ...）
# ZJU_USER_2=202600000002
# ZJU_PASSWORD_2=second_password_here
# ZJU_LABEL_2=副账号
# ZJU_LOCATION_2=西教学楼
# ZJU_ENABLED_2=true
# ZJU_AUTO_ANSWER_2=true
